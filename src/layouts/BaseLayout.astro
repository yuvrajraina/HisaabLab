---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'HisaabLab — free, transparent financial calculators for India',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  schema
} = Astro.props;
const configuredSite = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonical = configuredSite ? new URL(Astro.url.pathname, configuredSite).toString() : undefined;
const socialImage = configuredSite ? new URL(image, configuredSite).toString() : image;
const fullTitle = title.includes('HisaabLab') ? title : `${title} | HisaabLab`;
const adsPublisher = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID;
const adsActive = import.meta.env.PUBLIC_ADS_ENABLED === 'true' && /^ca-pub-\d+$/.test(adsPublisher || '');
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const graph = configuredSite && canonical ? [
  {
    '@type': 'Organization',
    '@id': `${configuredSite}/#organization`,
    name: 'HisaabLab',
    url: `${configuredSite}/`,
    logo: { '@type': 'ImageObject', url: `${configuredSite}/favicon.svg` },
    description: 'Free, transparent financial calculators and educational guides for Indian households.'
  },
  {
    '@type': 'WebSite',
    '@id': `${configuredSite}/#website`,
    url: `${configuredSite}/`,
    name: 'HisaabLab',
    description: 'Free financial calculators built for India.',
    publisher: { '@id': `${configuredSite}/#organization` },
    inLanguage: 'en-IN'
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    isPartOf: { '@id': `${configuredSite}/#website` },
    about: { '@id': `${configuredSite}/#organization` },
    primaryImageOfPage: { '@type': 'ImageObject', url: socialImage },
    inLanguage: 'en-IN',
    ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {})
  },
  ...pageSchemas.map((item) => Object.fromEntries(Object.entries(item).filter(([key]) => key !== '@context')))
] : [];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !configuredSite ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="HisaabLab" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#0b2b2d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {adsActive && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsPublisher}`} crossorigin="anonymous"></script>}
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
