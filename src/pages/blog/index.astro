---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const site=import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/,'');
const pageUrl=site?`${site}/blog/`:undefined;
const schema=[
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site?`${site}/`:undefined},{'@type':'ListItem',position:2,name:'Guides'}]},
  {'@type':'CollectionPage','@id':pageUrl?`${pageUrl}#collection`:undefined,name:'Personal finance guides for India',url:pageUrl,mainEntity:{'@type':'ItemList',itemListElement:posts.map((post,index)=>({'@type':'ListItem',position:index+1,name:post.data.title,url:site?`${site}/blog/${post.id}/`:undefined}))}}
];
---
<BaseLayout title="Personal Finance Guides India" description="Read practical, calculator-backed guides to home loans, prepayments, affordability, rent vs buy and property decisions in India." schema={schema}>
  <section class="page-hero center"><div class="container"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Guides'}]} /><span class="eyebrow">Practical money guides</span><h1>Understand the decision, not just the answer.</h1><p class="lead">Original, calculator-backed explanations for Indian households. No rate predictions, product pitches or universal rules.</p></div></section>
  <section class="section" style="padding-top:20px"><div class="container blog-grid">{posts.map((post,index)=><article class="blog-card"><div class="blog-art"><span>{index===0?'⚖':'↘'}</span></div><div class="blog-card-content"><span class="blog-meta">{post.data.readingMinutes} min read · Updated {post.data.updated.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><a href={`/blog/${post.id}/`}>Read guide →</a></div></article>)}</div></section>
</BaseLayout>
