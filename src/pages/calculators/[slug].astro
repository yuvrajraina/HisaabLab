---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import CalculatorApp from '../../components/calculators/CalculatorApp';
import AdSlot from '../../components/advertising/AdSlot.astro';
import { calculators, calculatorById, type Calculator } from '../../data/calculators';
import { references } from '../../data/references';

export function getStaticPaths() { return calculators.map(calculator=>({params:{slug:calculator.id},props:{calculator}})); }
const { calculator } = Astro.props as { calculator: Calculator };
const site = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/,'');
const pageUrl = site ? `${site}${calculator.path}` : undefined;
const schema = [
  { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:site?`${site}/`:undefined},{'@type':'ListItem',position:2,name:'Calculators',item:site?`${site}/calculators/`:undefined},{'@type':'ListItem',position:3,name:calculator.shortName,item:pageUrl}]},
  { '@context':'https://schema.org','@type':'WebApplication',name:calculator.name,description:calculator.description,applicationCategory:'FinanceApplication',operatingSystem:'Any',isAccessibleForFree:true,url:pageUrl,offers:{'@type':'Offer',price:'0',priceCurrency:'INR'} },
  { '@context':'https://schema.org','@type':'FAQPage',mainEntity:calculator.faqs.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}})) }
];
const related=calculator.related.map(id=>calculatorById[id]);
const adSlot=import.meta.env.PUBLIC_ADSENSE_CALCULATOR_SLOT;
---
<BaseLayout title={calculator.title} description={calculator.description} schema={schema}>
  <section class="calculator-intro"><div class="container"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Calculators',href:'/calculators/'},{label:calculator.shortName}]} /><div class="calculator-intro-grid"><div><span class="eyebrow">{calculator.category} · free calculator</span><h1>{calculator.name}</h1><p class="lead">{calculator.description}</p></div><aside class="intro-aside"><strong>Your data stays with you</strong><p>Calculations run locally in this browser. HisaabLab does not receive or store the numbers you enter.</p></aside></div></div></section>
  <CalculatorApp calculator={calculator} client:load />
  <AdSlot slot={adSlot} />
  <section class="content-section"><div class="container content-grid"><article class="prose"><h2>How this {calculator.shortName.toLowerCase()} works</h2><p>{calculator.formula}</p><div class="worked-example"><h3>Worked example</h3><p>{calculator.example}</p><p><strong>Try it yourself:</strong> the form above starts with these illustrative values. Change any input to see the result and chart update instantly.</p></div><h2>Assumptions used</h2><ul>{calculator.assumptions.map(item=><li>{item}</li>)}</ul><h2>What this estimate does not cover</h2><ul>{calculator.limitations.map(item=><li>{item}</li>)}</ul><p>Financial contracts can use day-count, rounding, reset and fee conventions that differ from this educational model. Use your lender’s official schedule for a contractual figure.</p><h2>Frequently asked questions</h2><div class="faq-list">{calculator.faqs.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div><h2>Official references</h2><p>Regulatory statements are deliberately limited and linked to primary sources. These sources were last reviewed on 3 November 2026.</p><ul>{references.map(ref=><li><a href={ref.url} rel="external noreferrer">{ref.title}</a> — {ref.scope}</li>)}</ul></article><aside class="sticky-related"><div class="related-box"><h2>Related calculators</h2>{related.map(item=><a href={item.path}><span>{item.shortName}</span><b aria-hidden="true">→</b></a>)}</div><div class="disclaimer-box"><strong>Educational estimate</strong><p>Not financial, investment, tax or legal advice. Verify rates, fees and eligibility with the relevant lender or adviser.</p></div></aside></div></section>
</BaseLayout>
