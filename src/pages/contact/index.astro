---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
const email=import.meta.env.PUBLIC_CONTACT_EMAIL;
---
<BaseLayout title="Contact HisaabLab" description="Contact HisaabLab about calculation feedback, corrections, accessibility or website questions.">
  <section class="simple-page"><div class="container"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Contact'}]} /><div class="simple-page-grid"><nav><a href="#contact">Contact</a><a href="#help">What to include</a><a href="#privacy">Privacy</a></nav><article class="prose"><span class="eyebrow">Contact</span><h1 id="contact">Help us make the maths clearer.</h1><p class="lead">Send calculation feedback, corrections, accessibility issues or a general website question.</p>{email?<div class="contact-card"><h2>Email HisaabLab</h2><p><a href={`mailto:${email}`}>{email}</a></p><p>We do not provide personalised financial advice or respond as a lender.</p></div>:<div class="notice"><strong>Contact email is being configured.</strong><p>The site owner must set <code>PUBLIC_CONTACT_EMAIL</code> before launch. No placeholder address is displayed.</p></div>}<h2 id="help">What to include</h2><p>For a calculation question, include the calculator name, inputs you used, result you expected and result you saw. Do not send account numbers, identity documents, passwords or other sensitive financial information.</p><h2 id="privacy">Privacy</h2><p>Email is handled by the configured mail provider, separately from the calculators. Calculator inputs remain in your browser and are not automatically attached to your message.</p></article></div></div></section>
</BaseLayout>
